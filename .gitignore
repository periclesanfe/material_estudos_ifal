# nao para ser publicados. Mesma regra de .classroom/.
Apostila_*.docx
Apostila_*.pdf

# Pareceres dos agentes criticos — artefato de processo, nao conteudo do site
.reviews/

# Pesquisa de design de sistemas de terceiros — artefato de decisao nossa, nao
# conteudo do site. Mesma logica de .reviews/
.docs/duolingo/

# Páginas de laboratório visual — servem para comparar protótipos durante o
# desenvolvimento e não fazem parte do site
src/pages/*Lab.tsx

